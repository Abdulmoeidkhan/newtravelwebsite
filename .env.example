# Firebase console > Project settings > Your apps > Web app configuration (public values)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1
# Register the site in Firebase App Check with reCAPTCHA Enterprise.
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Local emulators only. Never enable on a hosted build.
VITE_USE_FIREBASE_EMULATORS=false
